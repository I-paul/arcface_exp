# ARCFACE EXPERIMENT - UNIFIED ENVIRONMENT CONFIGURATION
# EXAMPLE / TEMPLATE FILE
# Copy this file to .env and fill in your actual values
# Keep your .env file secure and never commit it to version control

# BACKEND SERVICE CONFIGURATION
# Node.js API Server Settings

# Server Configuration
NODE_ENV=development
PORT=3000

# Database Configuration (PostgreSQL)
# Update these with your actual database credentials
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_secure_password_here
DB_NAME=attendance_DB

# Redis Configuration
# In Docker: use service name 'redis'
# Local development: use 'localhost'
REDIS_HOST=redis
REDIS_PORT=6379

# ML Service Configuration
# In Docker: use service name 'ml_service'
# Local development: use 'localhost:8000'
ML_SERVICE_URL=http://ml_service:8000

# Frontend Configuration (CORS)
# Update with your frontend URL
FRONTEND_URL=http://localhost:5173

# Logging
LOG_LEVEL=debug


# ML SERVICE CONFIGURATION
# Face Recognition API Settings

# Python Configuration
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1

# Milvus Vector Database Configuration
# In Docker: use service name 'milvus'
# Local development: use 'localhost'
MILVUS_HOST=milvus
MILVUS_PORT=19530

# Model Configuration
# Set FORCE_GPU=False if NVIDIA GPU is not available
FORCE_GPU=True
GPU_MEMORY_FRACTION=0.8

# Face Detection Configuration
# Adjust thresholds based on your accuracy requirements
# Lower values = more sensitive (more false positives)
# Higher values = more strict (may miss some faces)
FACE_DETECTION_THRESHOLD=0.5
FACE_RECOGNITION_THRESHOLD=0.6

# Service Configuration
SERVICE_HOST=0.0.0.0
SERVICE_PORT=8000
WORKERS=4

# Logging Configuration
# ML Service Log Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
# DEBUG=False

# CORS Configuration
# Set to specific origins in production (e.g., http://yourdomain.com)
ALLOWED_ORIGINS=*

# Model Cache
# Path where ML models will be cached
MODEL_CACHE_PATH=/app/models


# NOTES
# - For Docker deployment, use service names (redis, milvus, ml_service)
# - For local development, use localhost
# - Keep DB_PASSWORD secure and use strong passwords in production
# - Adjust thresholds based on your use case and testing
