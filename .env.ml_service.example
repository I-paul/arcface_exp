# ============================================
# ML SERVICE ENVIRONMENT VARIABLES
# Face Recognition API Configuration
# Example / Template Configuration
# ============================================
# Copy this file to .env.ml_service and fill in your values

# Python Configuration
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1

# Milvus Vector Database Configuration
# In Docker, use service name 'milvus'
# For local development, use 'localhost'
MILVUS_HOST=milvus
MILVUS_PORT=19530

# Model Configuration
# Set FORCE_GPU=False if NVIDIA GPU is not available
FORCE_GPU=True
GPU_MEMORY_FRACTION=0.8

# Face Detection Configuration
# Adjust thresholds based on your accuracy requirements
FACE_DETECTION_THRESHOLD=0.5
FACE_RECOGNITION_THRESHOLD=0.6

# Service Configuration
SERVICE_HOST=0.0.0.0
SERVICE_PORT=8000
WORKERS=4

# Logging Configuration
LOG_LEVEL=INFO
DEBUG=False

# CORS Configuration
ALLOWED_ORIGINS=*

# Model Cache
MODEL_CACHE_PATH=/app/models
